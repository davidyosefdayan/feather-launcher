<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and 12 can't tell the service when a text box is being typed in (13 can, see
     xml-v33), so there it reads which box is in focus. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents|flagInputMethodEditor"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="0"
    android:description="@string/accessibility_description" />
